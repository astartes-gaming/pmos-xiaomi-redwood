[Unit]
Description=Re-initialise USB controller after boot (redwood workaround)
# Something ~16 s into boot leaves the DWC3 controller unable to enumerate
# (the host drops the device). Rebinding dwc3-qcom and the pmOS gadget fixes it.

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'd=/sys/bus/platform/drivers/dwc3-qcom; g=/sys/kernel/config/usb_gadget/g1; echo a600000.usb > $d/unbind; sleep 2; echo a600000.usb > $d/bind; sleep 2; [ -d $g ] && [ -z "$(cat $g/UDC)" ] && echo a600000.usb > $g/UDC; true'

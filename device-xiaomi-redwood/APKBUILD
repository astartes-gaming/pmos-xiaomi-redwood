# Reference: <https://postmarketos.org/devicepkg>
# Maintainer: TODO <you@example.com>
pkgname=device-xiaomi-redwood
pkgdesc="Xiaomi POCO X5 Pro 5G / Redmi Note 12 Pro Speed"
pkgver=1
pkgrel=4
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	alsa-ucm-conf-qcom-sc7280
	firmware-qcom-adreno-a660
	firmware-xiaomi-redwood
	linux-firmware-ath11k
	linux-firmware-qca
	linux-postmarketos-qcom-sc7280
	make-dynpart-mappings
	mkbootimg
	postmarketos-base
	soc-qcom
	soc-qcom-modem
	soc-qcom-qbootctl
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	modules-initfs
	ucm-redwood.conf
	ucm-HiFi.conf
	60-redwood-cutout.conf
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# ALSA UCM: speakers (AW88261 via Primary MI2S)
	install -Dm644 "$srcdir"/ucm-redwood.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Xiaomi/redwood/redwood.conf
	install -Dm644 "$srcdir"/ucm-HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Xiaomi/redwood/HiFi.conf
	mkdir -p "$pkgdir"/usr/share/alsa/ucm2/conf.d/sm7325
	ln -s ../../Xiaomi/redwood/redwood.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/sm7325/redwood.conf

	# Phosh: display cutout (see file)
	install -Dm644 "$srcdir"/60-redwood-cutout.conf \
		"$pkgdir"/usr/lib/environment.d/60-redwood-cutout.conf
}


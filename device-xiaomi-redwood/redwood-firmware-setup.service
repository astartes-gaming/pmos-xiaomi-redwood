[Unit]
Description=Install redwood firmware from the phone's own partitions
# Public builds ship no blobs. Only runs while the firmware is missing
# (never when firmware-xiaomi-redwood is installed); reboots once so every
# driver starts with its firmware present.
ConditionPathExists=!/lib/firmware/qcom/sm7325/xiaomi/redwood/modem.mbn
After=local-fs.target systemd-udev-settle.service
Wants=systemd-udev-settle.service
DefaultDependencies=no
Before=sysinit.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/redwood-firmware-setup
ExecStartPost=/bin/systemctl --no-block reboot

[Install]
WantedBy=sysinit.target

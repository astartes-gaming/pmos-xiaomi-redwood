# Reference: <https://postmarketos.org/deviceinfo>
# Please use double quotes only. You can source this file in shell
# scripts.
#
# Based on device-nothing-spacewar (same SoC family, sm7325 / sc7280 kernel).
# Values marked TODO must be verified against the redwood stock boot.img
# (`unpack_bootimg --boot_img boot.img`) before flashing.

deviceinfo_format_version="0"
deviceinfo_name="Xiaomi POCO X5 Pro 5G / Redmi Note 12 Pro Speed"
deviceinfo_manufacturer="Xiaomi"
deviceinfo_codename="xiaomi-redwood"
deviceinfo_year="2023"
deviceinfo_dtb="qcom/sm7325-xiaomi-redwood"
deviceinfo_append_dtb="true"
deviceinfo_arch="aarch64"
deviceinfo_flash_kernel_on_update="true"

# Device related
deviceinfo_drm="true"
deviceinfo_chassis="handset"
deviceinfo_screen_width="1080"
deviceinfo_screen_height="2400"

# Bootloader related
deviceinfo_flash_method="fastboot"

deviceinfo_generate_bootimg="true"
# Stock redwood uses boot header v3 + vendor_boot (A/B), pagesize 4096, base 0x0
# (crdroidandroid/android_device_xiaomi_redwood BoardConfig.mk).
# Header v2 with appended DTB is used here like nothing-spacewar (same SoC
# family, also v3 stock); Qualcomm ABL usually still accepts v2 images.
# If the phone refuses to boot it, switch to header v3 + vendor_boot.
deviceinfo_kernel_cmdline="console=ttyMSM0,115200n8"
deviceinfo_header_version="2"
deviceinfo_flash_pagesize="4096"
deviceinfo_flash_offset_base="0x00000000"
deviceinfo_flash_offset_dtb="0x01f00000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x01000000"
deviceinfo_flash_offset_second="0x00000000"
deviceinfo_flash_offset_tags="0x00000100"
deviceinfo_rootfs_image_sector_size="4096"
# TODO: confirm the super partition node on redwood (`ls -l /dev/block/by-name/super` from TWRP/adb)
deviceinfo_super_partitions="/dev/sda6"
deviceinfo_flash_sparse="true"

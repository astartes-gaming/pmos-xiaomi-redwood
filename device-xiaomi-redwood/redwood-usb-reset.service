[Unit]
Description=Re-initialise USB controller after the ADSP comes up (redwood workaround)
# When the ADSP charger firmware starts (~16 s into boot) it re-detects the
# USB-C port and the HS PHY stops working: the host drops the device. A role
# toggle or gadget rebind does not recover it; rebinding dwc3-qcom (which
# re-initialises the PHY) does. Wait for the ADSP, then rebind once.

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for i in $(seq 120); do for r in /sys/class/remoteproc/*; do [ "$(cat $r/name)" = adsp ] && [ "$(cat $r/state)" = running ] && break 2; done; sleep 0.5; done; sleep 3; d=/sys/bus/platform/drivers/dwc3-qcom; g=/sys/kernel/config/usb_gadget/g1; echo a600000.usb > $d/unbind; sleep 2; echo a600000.usb > $d/bind; sleep 2; [ -d $g ] && [ -z "$(cat $g/UDC)" ] && echo a600000.usb > $g/UDC; true'

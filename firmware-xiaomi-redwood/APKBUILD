# Maintainer: diegosace2000 <diegosace2000@users.noreply.github.com>
#
# Proprietary firmware for the Xiaomi POCO X5 Pro 5G (redwood), taken from the
# stock vendor partition (/vendor/firmware) and the phone's own modem
# partition (NON-HLOS). The blobs are NOT in this repository: place them next
# to this APKBUILD before building (tools/collect-firmware.sh).
pkgname=firmware-xiaomi-redwood
pkgver=1
pkgrel=7
pkgdesc="Firmware for Xiaomi POCO X5 Pro 5G / Redmi Note 12 Pro Speed"
url="https://github.com/astartes-gaming/pmos-xiaomi-redwood"
arch="aarch64"
license="proprietary"
options="!check !strip !archcheck !tracedeps pmb:cross-native"
source="
	focaltech_ts_fw_m20.bin
	a660_zap.mbn
	wpss.mbn
	board-2.bin
	regdb.bin
	adsp.mbn
	adspr.jsn
	adsps.jsn
	adspua.jsn
	battmgr.jsn
	aw88261_acf.bin
	hexagonfs.tar.gz
	msbtfw11.mbn
	msnv11.bin
	modem.mbn
	modemr.jsn
	ipa_fws.mbn
	modem_pr.tar.gz
"

package() {
	# FocalTech FT3680 touch: flashless, loaded into the chip's RAM at boot
	install -Dm644 "$srcdir"/focaltech_ts_fw_m20.bin \
		"$pkgdir"/lib/firmware/focaltech_ts_fw_m20.bin
	# Adreno 642L zap shader (signed for this device)
	install -Dm644 "$srcdir"/a660_zap.mbn \
		"$pkgdir"/lib/firmware/qcom/sm7325/xiaomi/redwood/a660_zap.mbn
	# Wi-Fi subsystem (WPSS) firmware, from the modem partition
	install -Dm644 "$srcdir"/wpss.mbn \
		"$pkgdir"/lib/firmware/qcom/sm7325/xiaomi/redwood/wpss.mbn
	# WCN6750 calibration: redwood global (bd_m20gl.elf) wrapped by
	# tools/ath11k_board2.py as "bus=ahb,qmi-chip-id=1,qmi-board-id=255",
	# plus Xiaomi's regulatory database. postmarketos/ is searched first.
	local d="$pkgdir"/lib/firmware/postmarketos/ath11k/WCN6750/hw1.0
	install -Dm644 "$srcdir"/board-2.bin "$d"/board-2.bin
	install -Dm644 "$srcdir"/regdb.bin "$d"/regdb.bin

	# Audio DSP (ADSP) firmware + protection-domain service files, and the
	# Awinic AW88261 speaker amp configuration (vendor aw882xx_acf.bin)
	local q="$pkgdir"/lib/firmware/qcom/sm7325/xiaomi/redwood
	install -Dm644 "$srcdir"/adsp.mbn "$q"/adsp.mbn
	install -Dm644 "$srcdir"/adspr.jsn "$q"/adspr.jsn
	install -Dm644 "$srcdir"/adsps.jsn "$q"/adsps.jsn
	install -Dm644 "$srcdir"/adspua.jsn "$q"/adspua.jsn
	install -Dm644 "$srcdir"/battmgr.jsn "$q"/battmgr.jsn
	install -Dm644 "$srcdir"/aw88261_acf.bin "$q"/aw88261_acf.bin

	# Modem (MPSS) firmware + service file, from the phone's modem partition;
	# modem_pr/ holds the MCFG carrier configs the modem fetches over
	# tqftpserv (without them it stays "offline"). IPA (mobile data) GSI
	# firmware from vendor /firmware/yupik_ipa_fws.
	install -Dm644 "$srcdir"/modem.mbn "$q"/modem.mbn
	install -Dm644 "$srcdir"/modemr.jsn "$q"/modemr.jsn
	install -Dm644 "$srcdir"/ipa_fws.mbn "$q"/ipa_fws.mbn
	cp -r "$srcdir"/modem_pr "$q"/
	find "$q"/modem_pr -type d -exec chmod 0755 {} +
	find "$q"/modem_pr -type f -exec chmod 0644 {} +

	# WCN6750 Bluetooth patch + redwood NVM (modem partition), ahead of the
	# generic linux-firmware copies via the postmarketos/ search path
	install -Dm644 -t "$pkgdir"/lib/firmware/postmarketos/qca \
		"$srcdir"/msbtfw11.mbn "$srcdir"/msnv11.bin

	# Files hexagonrpcd serves to the ADSP sensor hub (tools/collect-sensors.sh):
	# sensor configs, sns_reg.conf, this phone's calibrated registry (persist),
	# ADSP libraries (dsp partition) and socinfo. Path is derived by
	# hexagonrpcd from the DT: qcom,<soc> / model vendor / <vendor>,<device>.
	local h="$pkgdir"/usr/share/qcom/sm7325/Xiaomi/redwood
	mkdir -p "$h"
	cp -r "$srcdir"/hexagonfs/. "$h"/
	find "$h" -type d -exec chmod 0755 {} +
	find "$h" -type f -exec chmod 0644 {} +
}






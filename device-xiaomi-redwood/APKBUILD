# Reference: <https://postmarketos.org/devicepkg>
# Maintainer: TODO <you@example.com>
pkgname=device-xiaomi-redwood
pkgdesc="Xiaomi POCO X5 Pro 5G / Redmi Note 12 Pro Speed"
pkgver=1
pkgrel=16
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	alsa-ucm-conf-qcom-sc7280
	firmware-qcom-adreno-a660
	linux-firmware-ath11k
	linux-firmware-qca
	linux-postmarketos-qcom-sc7280
	make-dynpart-mappings
	mkbootimg
	postmarketos-base
	soc-qcom
	soc-qcom-modem
	soc-qcom-qbootctl
	hexagonrpcd
	iio-sensor-proxy
	libssc
	e2fsprogs-extra
	python3
	device-mapper
"
makedepends="devicepkg-dev"
subpackages="$pkgname-nonfree-firmware:nonfree_firmware"
source="
	deviceinfo
	modules-initfs
	ucm-redwood.conf
	ucm-HiFi.conf
	60-redwood-cutout.conf
	redwood-usb-reset.sh
	redwood-usb-reset.service
	redwood-usb-reset.timer
	redwood-usb-replug.service
	71-redwood-usb-replug.rules
	72-redwood-bt-nowake.rules
	redwood-firmware-setup.sh
	redwood-firmware-setup.service
	squash_mdt.py
	ath11k_board2.py
	81-libssc-xiaomi-redwood.rules
	90_redwood-cbd.gschema.override
	70-redwood-lirc.rules
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# ALSA UCM: speakers (AW88261 via Primary MI2S), mics (WCD938x)
	install -Dm644 "$srcdir"/ucm-redwood.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Xiaomi/redwood/redwood.conf
	install -Dm644 "$srcdir"/ucm-HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Xiaomi/redwood/HiFi.conf
	mkdir -p "$pkgdir"/usr/share/alsa/ucm2/conf.d/sm7325
	ln -s ../../Xiaomi/redwood/redwood.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/sm7325/redwood.conf

	# Phosh: display cutout (see file)
	install -Dm644 "$srcdir"/60-redwood-cutout.conf \
		"$pkgdir"/usr/lib/environment.d/60-redwood-cutout.conf

	# USB: the charger firmware breaks the HS PHY at ADSP start and on each
	# plug-in; re-initialise the controller then (see redwood-usb-reset.sh)
	install -Dm755 "$srcdir"/redwood-usb-reset.sh \
		"$pkgdir"/usr/libexec/redwood-usb-reset
	install -Dm644 -t "$pkgdir"/usr/lib/systemd/system \
		"$srcdir"/redwood-usb-reset.service "$srcdir"/redwood-usb-reset.timer \
		"$srcdir"/redwood-usb-replug.service
	install -Dm644 "$srcdir"/71-redwood-usb-replug.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d

	# Public builds: install firmware from the phone's own partitions on
	# first boot (no-op when firmware-xiaomi-redwood is installed)
	install -Dm755 "$srcdir"/redwood-firmware-setup.sh \
		"$pkgdir"/usr/libexec/redwood-firmware-setup
	install -Dm644 -t "$pkgdir"/usr/libexec/redwood-fw \
		"$srcdir"/squash_mdt.py "$srcdir"/ath11k_board2.py
	install -Dm644 -t "$pkgdir"/usr/lib/systemd/system \
		"$srcdir"/redwood-firmware-setup.service
	mkdir -p "$pkgdir"/usr/lib/systemd/system/sysinit.target.wants
	ln -s ../redwood-firmware-setup.service \
		"$pkgdir"/usr/lib/systemd/system/sysinit.target.wants/redwood-firmware-setup.service

	# Suspend: the Bluetooth UART wake IRQ aborts every suspend attempt
	install -Dm644 "$srcdir"/72-redwood-bt-nowake.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d
	mkdir -p "$pkgdir"/usr/lib/systemd/system/timers.target.wants
	ln -s ../redwood-usb-reset.timer \
		"$pkgdir"/usr/lib/systemd/system/timers.target.wants/redwood-usb-reset.timer

	# Phosh's usb-signaller replaces the pmOS USB network gadget ~1 min
	# into boot (new IP, tether drops). Mask it; pmOS's gadget stays.
	mkdir -p "$pkgdir"/etc/systemd/system
	ln -s /dev/null "$pkgdir"/etc/systemd/system/usb-signaller.service

	# Sensors (ADSP sensor hub via hexagonrpcd + libssc): accelerometer
	# mount matrix for iio-sensor-proxy
	install -Dm644 "$srcdir"/81-libssc-xiaomi-redwood.rules \
		"$pkgdir"/usr/lib/udev/rules.d/81-libssc-xiaomi-redwood.rules

	# Cell broadcast: also AMBER and test levels (SAE test alerts)
	install -Dm644 "$srcdir"/90_redwood-cbd.gschema.override \
		-t "$pkgdir"/usr/share/glib-2.0/schemas

	# IR blaster: logged-in user may transmit (uaccess, before 73-seat-late)
	install -Dm644 "$srcdir"/70-redwood-lirc.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d
}

nonfree_firmware() {
	pkgdesc="Firmware copied from a redwood (otherwise installed from the phone's own partitions on first boot)"
	depends="firmware-xiaomi-redwood"
	mkdir "$subpkgdir"
}

